            <Block Type="MyObjectBuilder_Assembler" Subtype="LargeAssemblerIndustrial" />
            <Block Type="MyObjectBuilder_Assembler" Subtype="LargeAssembler" />
            <Block Type="MyObjectBuilder_Assembler" Subtype="LargePrototechAssembler" />
