<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
        <Definition xsi:type="MyObjectBuilder_OxygenFarmDefinition">
			<Id>
				<TypeId>OxygenFarm</TypeId>
				<SubtypeId>SmallOxygenFarm</SubtypeId>
			</Id>
            <DisplayName>Small Oxygen Farm</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\SmallOxygenFarm.dds</Icon>
            <Description>Description_OxygenFarm</Description>
            <CubeSize>Small</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="8" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
            <Center x="1" y="0" z="1" />
            <Model>Models\Cubes\small\SmallOxygenFarm.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="15" />
                <Component Subtype="BulletproofGlass" Count="20" />
                <Component Subtype="SmallTube" Count="10" />
                <Component Subtype="Construction" Count="15" />
                <Component Subtype="Computer" Count="10" />
                <Component Subtype="BulletproofGlass" Count="10" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.70"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.70"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.70"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.70"/>
				<MountPoint Side="Top" StartX="1.80" StartY="1.30" EndX="2.20" EndY="1.70"/>
				<MountPoint Side="Top" StartX="0.80" StartY="1.30" EndX="1.20" EndY="1.70"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
            <MirroringX>Y</MirroringX>
            <MirroringY>X</MirroringY>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\small\SmallOxygenFarm_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\small\SmallOxygenFarm_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\small\SmallOxygenFarm_BS3.mwm"/>
			</BuildProgressModels>
            <BlockPairName>OxygenFarm</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>30</BuildTimeSeconds>
            <PanelOrientation>
                <X>0</X>
                <Y>0</Y>
                <Z>-1</Z>
            </PanelOrientation>
            <TwoSidedPanel>true</TwoSidedPanel>
            <PanelOffset>0</PanelOffset>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <ResourceSourceGroup>SolarPanels</ResourceSourceGroup>
            <ProducedGas>
                <Id>
                    <TypeId>GasProperties</TypeId>
                    <SubtypeId>Oxygen</SubtypeId>
                </Id>
                <MaxOutputPerSecond>0.03</MaxOutputPerSecond>
            </ProducedGas>
            <OperationalPowerConsumption>0.015</OperationalPowerConsumption>
            <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
            <DamagedSound>ParticleWeapExpl</DamagedSound>
            <EmissiveColorPreset>Default</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>25</PCU>
