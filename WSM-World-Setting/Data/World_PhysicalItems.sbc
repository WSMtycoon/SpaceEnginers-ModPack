<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <PhysicalItems>

        <!-- Ores -->

        <PhysicalItem xsi:type="MyObjectBuilder_ConsumableItemDefinition">
            <Id>
                <TypeId>ConsumableItem</TypeId>
                <SubtypeId>Powerkit</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Item_Powerkit</DisplayName>
            <Description>Description_Powerkit</Description>
            <Icon>Textures\GUI\Icons\Items\PowerKit.dds</Icon>
            <Size>
                <X>0.2</X>
                <Y>0.2</Y>
                <Z>0.2</Z>
            </Size>
            <Mass>5</Mass>
            <Volume>5</Volume>
            <Model>Models\Items\PowerKit.mwm</Model>
            <PhysicalMaterial>Metal</PhysicalMaterial>
            <Stats>
                <Stat Name="BatteryCharge" Value ="0.1" Time="30"/>
            </Stats>
			<UseSound>PlayUsePowerKit</UseSound>
			<ExtraInventoryTooltipLineId>Item_Powerkit_Extra_Tooltip</ExtraInventoryTooltipLineId>

            <MinimumOfferAmount>5</MinimumOfferAmount>
            <MaximumOfferAmount>50</MaximumOfferAmount>
			<DepositAllEnabled>false</DepositAllEnabled>
            <CanPlayerOrder>true</CanPlayerOrder>
            <CanPlayerOffer>true</CanPlayerOffer>
        </PhysicalItem>

    </PhysicalItems>
</Definitions>
