    <Blueprints>
		<!-- Resource Processing -->
		        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>StoneOreToIngot</SubtypeId>
            </Id>
            <DisplayName>DisplayName_BlueprintClass_Ingots</DisplayName>
            <Icon>Textures\GUI\Icons\ingot\ingot_class.dds</Icon>
            <Prerequisites>
                <Item Amount="1000" TypeId="Ore" SubtypeId="Stone" />
            </Prerequisites>
            <Results>
                <Item Amount="10" TypeId="Ingot" SubtypeId="Stone" />
                <Item Amount="39" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="3.9" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="12.0" TypeId="Ingot" SubtypeId="Silicon" />
	            <Item Amount="0.3" TypeId="Ingot" SubtypeId="Cobalt" />
	            <Item Amount="0.15" TypeId="Ingot" SubtypeId="Magnesium" />
                <Item Amount="50.0" TypeId="Ore" SubtypeId="Ice" />
            </Results>
            <BaseProductionTimeInSeconds>20</BaseProductionTimeInSeconds>
        </Blueprint>

        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>Position0010_StoneOreToIngotBasic</SubtypeId>
