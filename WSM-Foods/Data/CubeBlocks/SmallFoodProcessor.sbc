<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
			<Id>
				<TypeId>Assembler</TypeId>
				<SubtypeId>SmallFoodProcessor</SubtypeId>
			</Id>
            <DisplayName>Small Food Processor</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\SmallFoodProcessor.dds</Icon>
            <Description>Description_FoodProcessor</Description>
            <CubeSize>Small</CubeSize>
            <GuiVisible>false</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Center x="1" y="1" z="1"/>
			<Model>Models\Cubes\small\SmallFoodProcessor.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="5" />
                <Component Subtype="Construction" Count="20" />
                <Component Subtype="Motor" Count="4" />
                <Component Subtype="Display" Count="2" />
                <Component Subtype="Computer" Count="20" />
                <Component Subtype="BulletproofGlass" Count="6" />
                <Component Subtype="SteelPlate" Count="5" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.10"/>
				<MountPoint Side="Front" StartX="0.40" StartY="1.10" EndX="3.00" EndY="2.35"/>
				<MountPoint Side="Front" StartX="0.00" StartY="2.80" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Front" StartX="0.09" StartY="2.35" EndX="3.00" EndY="2.80"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.10"/>
				<MountPoint Side="Back" StartX="0.00" StartY="1.10" EndX="2.60" EndY="2.35"/>
				<MountPoint Side="Back" StartX="0.00" StartY="2.80" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="2.35" EndX="2.91" EndY="2.80"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.10"/>
				<MountPoint Side="Right" StartX="0.00" StartY="2.80" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\small\SmallFoodProcessor_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\small\SmallFoodProcessor_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\small\SmallFoodProcessor_BS3.mwm"/>
			</BuildProgressModels>
            <BlockPairName>FoodProcessor</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>20</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>1</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.002</StandbyPowerConsumption>
            <OperationalPowerConsumption>0.09</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>FoodProcessorRations</Class>
				<Class>FoodProcessorSeeds</Class>
            </BlueprintClasses>
            <AssemblySpeed>0.5</AssemblySpeed>
            <ScreenAreas>
                <ScreenArea Name="CockpitScreen_01" DisplayName="DisplayName_Screen_Large" TextureResolution="256" ScreenWidth="7" ScreenHeight="6" />
            </ScreenAreas>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <MirroringY>X</MirroringY>
            <MirroringX>Y</MirroringX>
            <TieredUpdateTimes>
                <unsignedInt>60</unsignedInt>
                <unsignedInt>120</unsignedInt>
                <unsignedInt>240</unsignedInt>
            </TieredUpdateTimes>
            <IgnoreEfficiencyMultiplier>true</IgnoreEfficiencyMultiplier>
            <EnableDisassembly>false</EnableDisassembly>
            <EnableCooperativeMode>false</EnableCooperativeMode>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>
