// Добавьте эти поля в класс
private static readonly MyStringId[] m_rotationControls = new MyStringId[]
{
    MyControlsSpace.CUBE_ROTATE_VERTICAL_POSITIVE,    // Вверх
    MyControlsSpace.CUBE_ROTATE_VERTICAL_NEGATIVE,    // Вниз  
    MyControlsSpace.CUBE_ROTATE_HORISONTAL_POSITIVE,  // Вправо
    MyControlsSpace.CUBE_ROTATE_HORISONTAL_NEGATIVE,  // Влево
    MyControlsSpace.CUBE_ROTATE_ROLL_POSITIVE,        // Поворот по часовой
    MyControlsSpace.CUBE_ROTATE_ROLL_NEGATIVE,        // Поворот против часовой
};

private static readonly int[] m_rotationDirections = new int[6] { -1, 1, 1, -1, 1, -1 };
private int m_lastInputHandleTime;

private bool HandleRotationInput(MyEntity heldEnt, MatrixD cameraMatrix)
{
    int frameDt = MyAPIGateway.Session.GameplayFrameCounter - m_lastInputHandleTime;
    m_lastInputHandleTime += frameDt;

    Vector3 targetAngularVelocity = Vector3.Zero;
    bool hasManualRotation = false;

    // Получаем оси камеры
    Vector3 cameraRight = cameraMatrix.Right;
    Vector3 cameraUp = cameraMatrix.Up;
    Vector3 cameraForward = cameraMatrix.Forward;

    // Проверяем все 6 направлений вращения
    for (int i = 0; i < 6; i++)
    {
        // Используем системные настройки управления вместо хардкода клавиш
        if (MyControllerHelper.IsControl(MyControlsSpace.CubeBuilding, m_rotationControls[i], MyControlStateType.PRESSED))
        {
            hasManualRotation = true;
            
            // Определяем ось вращения на основе направления и камеры
            Vector3 rotationAxis = Vector3.Zero;
            int direction = m_rotationDirections[i];

            if (i < 2) // Вертикальное вращение (вверх/вниз)
            {
                rotationAxis = cameraUp; // Вращение вокруг оси "вверх" камеры
                direction *= 1; // Направление уже задано в m_rotationDirections
            }
            else if (i >= 2 && i < 4) // Горизонтальное вращение (влево/вправо)
            {
                rotationAxis = cameraRight; // Вращение вокруг оси "вправо" камеры  
                direction *= 1;
            }
            else if (i >= 4) // Вращение крена
            {
                rotationAxis = cameraForward; // Вращение вокруг оси "вперед" камеры
                direction *= 1;
            }

            // Применяем вращение
            if (rotationAxis.LengthSquared() > 0.1f)
            {
                float rotationSpeed = angel * 0.1f; // Настройте скорость по вкусу
                targetAngularVelocity = rotationAxis * direction * rotationSpeed;
                break; // Обрабатываем только одно нажатие за раз
            }
        }
    }

    // Применяем угловую скорость
    if (hasManualRotation && targetAngularVelocity.LengthSquared() > 0.0001f)
    {
        heldEnt.Physics.AngularVelocity = targetAngularVelocity;
        return true;
    }
    else
    {
        // Плавное замедление вращения при отсутствии ввода
        if (heldEnt.Physics.AngularVelocity.LengthSquared() > 0.0001f)
        {
            heldEnt.Physics.AngularVelocity *= 0.9f; // Коэффициент замедления
        }
        else
        {
            heldEnt.Physics.AngularVelocity = Vector3.Zero;
        }
        return false;
    }
}

// Обновленный основной метод
public void UpdateHeldObjectRotation(MyEntity heldEnt)
{
    if (heldEnt?.Physics == null) return;

    // Получаем матрицу камеры для определения ориентации
    IMyCamera camera = MyAPIGateway.Session.Camera;
    MatrixD cameraMatrix = camera.WorldMatrix;

    // Обрабатываем ввод вращения
    bool isRotating = HandleRotationInput(heldEnt, cameraMatrix);

    // Ваш существующий код для линейного движения
    Utils.AddForceTowards(heldEnt, (Vector3)currentPos, (Vector3)desiredPos, gridForward, !isRotating);
    
    // Если не вращаем вручную, можно добавить стабилизацию
    if (!isRotating)
    {
        // Опционально: стабилизация ориентации
        StabilizeRotation(heldEnt, cameraMatrix);
    }
}

